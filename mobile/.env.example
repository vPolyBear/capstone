# Supabase Project URL
# Connects the app to your Supabase project
# Required = Yes
# Go to Supabase.com, create a project, go into the project, open the left hand bar, 
# open `Project Settings` and from `General` the `Project ID`, add it in to the `your-project` 
# spot in the URL keep the rest the same
# Safe local value = https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public client key
# Allows for the app to communicate with Supabase
# Required = Yes
# Go to Supabase.com, after you have created a project, go into the project, open the left hand bar, 
# open `Project Settings` and go to API Keys and copy the `Publishable Key` and insert it into the 
# `your-anon-key` spot in the `ANON Key`
# Safe local value = your-anon-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key



# Test data selection
# Allows for the hostile test data tests when it is set to hostile
# Required = Optional
# This is set manually to TEST_DATA_SET=hostile when running the hostile tests
# Safe local value = Keep it blank
TEST_DATA_SET=